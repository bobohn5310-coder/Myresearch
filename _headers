# Cloudflare Pages 응답 헤더 설정
# 매일 자동 갱신되는 데이터는 브라우저가 항상 최신본을 확인하도록 합니다.
/data/*
  Cache-Control: no-cache

# 로고·아이콘은 자주 바뀌지 않으므로 하루 동안 캐시합니다.
/assets/*
  Cache-Control: public, max-age=86400

# 외부 라이브러리 사본(파일 이름에 버전이 들어 있어 내용이 절대 바뀌지 않음)은 1년 동안 캐시합니다.
# 버전을 올릴 때는 새 이름의 파일을 추가하고 HTML 의 주소를 바꿉니다.
/vendor/*
  Cache-Control: public, max-age=31536000, immutable

# 기본 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: camera=(), microphone=(), geolocation=(), usb=(), payment=()
  Content-Security-Policy: frame-ancestors 'self'; base-uri 'self'; object-src 'none'

# 페이지(HTML)와 화면 코드는 고칠 때마다 바로 보이도록 항상 최신본을 확인합니다.
/
  Cache-Control: no-cache
/index*
  Cache-Control: no-cache
# 관리자·내 캘린더 페이지는 광고가 없으므로 더 엄격하게: 우리 사이트와 Supabase 밖의 스크립트·통신을 막습니다.
# (혹시 누가 화면에 나쁜 코드를 끼워 넣어도 다른 서버로 정보를 보내거나 외부 스크립트를 불러올 수 없게)
/dashboard*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://ryikaxrcgfrgaczmmgnh.supabase.co wss://ryikaxrcgfrgaczmmgnh.supabase.co; frame-src 'self' blob: data:; worker-src 'self' blob:; form-action 'self'
/admin*
  Cache-Control: no-cache
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://ryikaxrcgfrgaczmmgnh.supabase.co wss://ryikaxrcgfrgaczmmgnh.supabase.co; frame-src 'self' blob: data:; worker-src 'self' blob:; form-action 'self'
