# Cloudflare Pages 응답 헤더 설정
# 매일 자동 갱신되는 데이터는 브라우저가 항상 최신본을 확인하도록 합니다.
/data/*
  Cache-Control: no-cache

# 로고·아이콘은 자주 바뀌지 않으므로 하루 동안 캐시합니다.
/assets/*
  Cache-Control: public, max-age=86400

# 기본 보안 헤더
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN

# 페이지(HTML)와 화면 코드는 고칠 때마다 바로 보이도록 항상 최신본을 확인합니다.
/
  Cache-Control: no-cache
/index*
  Cache-Control: no-cache
/dashboard*
  Cache-Control: no-cache
/admin*
  Cache-Control: no-cache
/cv.js
  Cache-Control: no-cache
